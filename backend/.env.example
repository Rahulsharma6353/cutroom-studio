# Backend settings (copy to backend/.env). The browser never sees these.
PORT=4000

# AI director (chat edits). Without a key, the editor uses its built-in rule-based planner.
ANTHROPIC_API_KEY=
DIRECTOR_MODEL=claude-opus-5-5

# Speech-to-text for captions and filler-word cuts. Any OpenAI-compatible
# /audio/transcriptions endpoint with word timestamps works (OpenAI Whisper, Groq, self-hosted).
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
# Optional: force a language, e.g. hi for Hindi. Leave empty to auto-detect.
STT_LANGUAGE=

# Stock B-roll from Pexels (free key: https://www.pexels.com/api/). Without it, only your own B-roll is used.
PEXELS_API_KEY=

# Where uploads, proxies and exports are stored (local disk for now).
STORAGE_DIR=./storage

# Rendering. Leave REMOTION_BROWSER empty to let Remotion download its own headless Chrome.
REMOTION_BROWSER=
# Origin the renderer uses to fetch media.
# RENDER_MEDIA_ORIGIN=http://127.0.0.1:4000   (defaults to this server)
RENDER_CONCURRENCY=
